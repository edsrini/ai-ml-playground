# Copy this file to .env (it is git-ignored) and adjust. Each file loads these with load_dotenv().
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
DB_PATH=sales.db        # SQLite file, relative to this folder (an absolute path also works)
MAX_ROWS=50             # most rows execute_sql returns to the model in one answer
