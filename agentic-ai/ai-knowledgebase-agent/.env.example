# Copy to .env (git-ignored). Every script reads these with load_dotenv().
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text   # the model that makes vectors; run `ollama pull nomic-embed-text` once
OLLAMA_BASE_URL=http://localhost:11434

DOCS_DIR=docs                         # the documents to load (.pdf, .md, .txt), relative to this folder
CHROMA_DIR=chroma-data                # where the vectors are saved, relative to this folder
COLLECTION_NAME=knowledge-base
CHUNK_SIZE=1000                       # characters per piece
CHUNK_OVERLAP=200                     # characters shared between neighbouring pieces
TOP_K=4                               # passages returned by one search

TAVILY_API_KEY=                       # your own key from https://app.tavily.com, for the web_search tool
